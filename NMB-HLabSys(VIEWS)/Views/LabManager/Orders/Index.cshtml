@using NMB_HLabSys_VIEWS_.Models
@model List<Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
    var lowStockItems = ViewBag.LowStockItems as List<Consumable> ?? new List<Consumable>();
    var supplierDict = ViewBag.SupplierDict as Dictionary<int, string> ?? new Dictionary<int, string>();
}
<style>
    .mgr-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .mgr-page-title {
        font-family: 'DM Serif Display', serif;
        font-size: 24px;
        color: var(--mgr-text-dark, #1e2420);
        margin: 0;
    }

    .mgr-btn-primary {
        background: var(--mgr-accent, #7a3030);
        border-color: var(--mgr-accent, #7a3030);
        color: #fff;
    }

        .mgr-btn-primary:hover {
            background: var(--mgr-accent-2, #9a4040);
            border-color: var(--mgr-accent-2, #9a4040);
            color: #fff;
        }

    .mgr-table {
        background: #fff;
        border: 1px solid var(--mgr-border, #ddd9d2);
        border-radius: 12px;
        overflow: hidden;
    }

        .mgr-table thead {
            background: var(--mgr-accent-pale, #f0e8e8);
            color: var(--mgr-accent, #7a3030);
        }

        .mgr-table th,
        .mgr-table td {
            vertical-align: middle;
            border-color: var(--mgr-border, #ddd9d2);
        }

    .mgr-badge {
        background: var(--mgr-accent-pale, #f0e8e8);
        color: var(--mgr-accent, #7a3030);
        font-weight: 600;
    }

    .mgr-action-btn {
        border-radius: 6px;
        font-size: 12px;
        padding: 6px 10px;
    }

        .mgr-action-btn.btn-outline-primary {
            border-color: var(--mgr-accent, #7a3030);
            color: var(--mgr-accent, #7a3030);
        }

            .mgr-action-btn.btn-outline-primary:hover {
                background: var(--mgr-accent, #7a3030);
                color: #fff;
            }
</style>

<div class="mgr-page-header">
    <h2 class="mgr-page-title">Orders</h2>
    <a asp-action="CreateOrder" class="btn mgr-btn-primary">
        <i class="bi bi-cart-plus me-1"></i> Create Order
    </a>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
    </div>
}

<!-- SMART ALERTS SECTION -->
@if (lowStockItems.Any())
{
    <div class="card border-warning mb-4 shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-exclamation-triangle-fill me-2"></i> Low Stock Alerts (@lowStockItems.Count items)</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Consumable</th>
                        <th>Supplier</th>
                        <th>Current Stock</th>
                        <th>Reorder Level</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lowStockItems)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.ConsumableName</td>
                            <td>@(supplierDict.ContainsKey(item.SupplierId) ? supplierDict[item.SupplierId] : "Unknown")</td>
                            <td class="text-danger fw-bold">@item.QuantityOnHand</td>
                            <td class="text-muted">@item.ReorderLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ORDERS TABLE SECTION -->
<div class="mgr-table-wrap">
    @if (!Model.Any())
    {
        <div class="alert alert-secondary">No orders have been placed yet.</div>
    }
    else
    {
        <table class="table table-hover mgr-table mb-0">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-bold">@order.OrderNumber</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@(supplierDict.ContainsKey(order.SupplierId) ? supplierDict[order.SupplierId] : "Unknown")</td>
                        <td>@order.Items.Count item(s)</td>
                        <td>
                            @if (order.Status == "Ordered")
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">Ordered</span>
                            }
                            else if (order.Status == "Received")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success">Received</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.Status</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <!-- Use a wrapper div for flexbox so it doesn't break the table cell alignment -->
                            <div class="d-flex justify-content-end align-items-center gap-2">

                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary mgr-action-btn">
                                    Details
                                </a>

                                <!-- One-Click Receive Button -->
                                @if (order.Status == "Ordered")
                                {
                                    <form asp-action="ReceiveOrder" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="btn btn-sm btn-success mgr-action-btn"
                                                onclick="return confirm('Mark this order as received? This will automatically update your consumable inventory.');">
                                            <i class="bi bi-box-arrow-in-down me-1"></i> Receive
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["StatusMessage"]</div>
    }
</div>
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cancelOrderId" name="id" value="" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"id="cancelOrderModalLabel">Cancel Order #<span id="cancelOrderNumber"></span></h5>
                </div>

                <div class="modal-body">
                    <p class="text-muted">Are you sure you want to cancel this order? This action cannot be undone.</p>
                    <div class="mb-3">
                        <label for="cancellationReason" class="form-label fw-semibold">Reason for Cancellation <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="cancellationReason" name="cancellationReason" rows="3" required placeholder="e.g., Ordered by mistake, wrong supplier..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
var cancelModal = document.getElementById('cancelOrderModal');
if (cancelModal) {
  cancelModal.addEventListener('show.bs.modal', function (event) {
    var button = event.relatedTarget;
    var id = button.getAttribute('data-order-id');
    var number = button.getAttribute('data-order-number');
    var input = cancelModal.querySelector('input[name="id"]');
    var span = cancelModal.querySelector('#cancelOrderNumber');
    if (input) input.value = id || '';
    if (span) span.textContent = number || '';
  });
}
</script>


