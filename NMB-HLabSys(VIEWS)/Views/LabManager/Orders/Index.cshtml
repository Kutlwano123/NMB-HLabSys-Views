@using NMB_HLabSys_VIEWS_.Models
@model List<Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
    var supplierNames = ViewBag.SupplierNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}
<style>
    .mgr-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .mgr-page-title {
        font-family: 'DM Serif Display', serif;
        font-size: 24px;
        color: var(--mgr-text-dark, #1e2420);
        margin: 0;
    }

    .mgr-btn-primary {
        background: var(--mgr-accent, #7a3030);
        border-color: var(--mgr-accent, #7a3030);
        color: #fff;
    }

        .mgr-btn-primary:hover {
            background: var(--mgr-accent-2, #9a4040);
            border-color: var(--mgr-accent-2, #9a4040);
            color: #fff;
        }

    .mgr-table {
        background: #fff;
        border: 1px solid var(--mgr-border, #ddd9d2);
        border-radius: 12px;
        overflow: hidden;
    }

        .mgr-table thead {
            background: var(--mgr-accent-pale, #f0e8e8);
            color: var(--mgr-accent, #7a3030);
        }

        .mgr-table th,
        .mgr-table td {
            vertical-align: middle;
            border-color: var(--mgr-border, #ddd9d2);
        }

    .mgr-badge {
        background: var(--mgr-accent-pale, #f0e8e8);
        color: var(--mgr-accent, #7a3030);
        font-weight: 600;
    }

    .mgr-action-btn {
        border-radius: 6px;
        font-size: 12px;
        padding: 6px 10px;
    }

        .mgr-action-btn.btn-outline-primary {
            border-color: var(--mgr-accent, #7a3030);
            color: var(--mgr-accent, #7a3030);
        }

            .mgr-action-btn.btn-outline-primary:hover {
                background: var(--mgr-accent, #7a3030);
                color: #fff;
            }
</style>

<div class="mgr-page-header">
    <h2 class="mgr-page-title">Orders</h2>
    <a asp-action="CreateOrder" class="btn mgr-btn-primary">
        <i class="bi bi-plus-circle"></i> Create Order
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No orders found. Create one to get started.</div>
}
else
{
    <table class="table table-hover mgr-table">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>Supplier</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@(supplierNames.TryGetValue(order.SupplierId, out var supplierName) ? supplierName : "Unassigned")</td>
                    <td><span class="badge mgr-badge">@order.Status</span></td>
                    <td class="text-center">
                        <a asp-action="OrderDetails" asp-route-id="@order.Id"
                           class="btn btn-sm btn-outline-primary mgr-action-btn">Details</a>
                        <a asp-action="ReceiveOrder" asp-route-id="@order.Id"
                           class="btn btn-sm btn-outline-success mgr-action-btn">Receive</a>
                        <a asp-action="DeleteOrder" asp-route-id="@order.Id"
                           class="btn btn-sm btn-outline-danger mgr-action-btn">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["StatusMessage"]</div>
}
