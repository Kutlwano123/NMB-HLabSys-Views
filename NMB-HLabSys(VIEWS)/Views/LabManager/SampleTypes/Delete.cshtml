@model NMB_HLabSys_VIEWS_.Models.SampleType
@{
    ViewData["Title"] = "Delete Sample Type";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}
<style>
    /* Add this if not already in your _ManagersLayout.cshtml */
    .mgr-delete-card {
        background: #fff;
        border: 1px solid #e2caca;
        border-radius: 12px;
        padding: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .mgr-delete-title {
        font-family: 'DM Serif Display', serif;
        font-size: 22px;
        color: #a33;
        margin-bottom: 6px;
    }

    .mgr-delete-warning {
        font-size: 13px;
        color: #7a3030;
        margin-bottom: 20px;
    }

    .mgr-delete-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
        display: grid;
        gap: 10px;
    }

    .mgr-delete-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 12px;
        background: #fdf5f5;
        border-radius: 8px;
        font-size: 13px;
        color: #4a5248;
    }

    .mgr-btn-danger {
        background: #dc3545;
        color: #fff;
        border: none;
    }

        .mgr-btn-danger:hover {
            background: #bb2d3b;
            color: #fff;
        }

    .mgr-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
</style>

<div class="mgr-delete-card">
    <h5 class="mgr-delete-title">Delete Sample Type</h5>

    @if (ViewBag.CanDelete == false)
    {
        <p class="mgr-delete-warning fw-bold">Cannot delete this sample type because it is currently assigned to one or more Test Types.</p>

        <ul class="mgr-delete-list">
            <li class="mgr-delete-item"><span>Sample Name</span><strong>@Model.Name</strong></li>
            <li class="mgr-delete-item"><span>Description</span><strong>@Model.Description</strong></li>
        </ul>

        <div class="mgr-actions">
            <a asp-action="SampleTypes" class="btn btn-outline-secondary">Back to List</a>
        </div>
    }
    else
    {
        <p class="mgr-delete-warning">This action cannot be undone. Please confirm you want to delete this sample type.</p>

        <ul class="mgr-delete-list">
            <li class="mgr-delete-item"><span>Sample Name</span><strong>@Model.Name</strong></li>
            <li class="mgr-delete-item"><span>Description</span><strong>@Model.Description</strong></li>
        </ul>

        <form asp-action="DeleteSampleType" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mgr-actions">
                <a asp-action="SampleTypes" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn mgr-btn-danger">Delete</button>
            </div>
        </form>
    }
</div>