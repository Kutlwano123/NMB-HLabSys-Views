@model NMB_HLabSys_VIEWS.ViewModels.TechnicianDetailsViewModel
@{
    ViewData["Title"] = "Lab Technician Details";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}
<style>
    .mgr-chip {
        display: inline-block;
        padding: 4px 12px;
        background-color: var(--mgr-bg, #f4f2ef);
        border: 1px solid var(--mgr-border, #ddd9d2);
        border-radius: 16px;
        font-size: 12px;
        color: var(--mgr-text-dark, #1e2420);
        margin-right: 5px;
        margin-bottom: 5px;
    }

    .mgr-detail-card {
        background: #fff;
        border: 1px solid var(--mgr-border, #ddd9d2);
        border-radius: 12px;
        padding: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .mgr-detail-title {
        font-family: 'DM Serif Display', serif;
        font-size: 22px;
        color: var(--mgr-text-dark, #1e2420);
        margin-bottom: 6px;
    }

    .mgr-detail-subtitle {
        font-size: 13px;
        color: var(--mgr-text-mid, #4a5248);
        margin-bottom: 20px;
    }

    .mgr-detail-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
        display: grid;
        gap: 10px;
    }

    .mgr-detail-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 12px;
        background: var(--mgr-bg, #f4f2ef);
        border-radius: 8px;
        font-size: 13px;
        color: var(--mgr-text-mid, #4a5248);
    }

    .mgr-chip {
        background: var(--mgr-accent-pale, #f0e8e8);
        color: var(--mgr-accent, #7a3030);
        font-weight: 600;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .mgr-section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--mgr-text-dark, #1e2420);
        margin-bottom: 8px;
    }

    .mgr-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .mgr-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .mgr-btn-primary {
        background: var(--mgr-accent, #7a3030);
        border-color: var(--mgr-accent, #7a3030);
        color: #fff;
    }

        .mgr-btn-primary:hover {
            background: var(--mgr-accent-2, #9a4040);
            border-color: var(--mgr-accent-2, #9a4040);
            color: #fff;
        }
</style>

<div class="mgr-detail-card">
    <h5 class="mgr-detail-title">@Model.Name @Model.Surname</h5>
    <p class="mgr-detail-subtitle">Review lab technician information, contact details, and associated tests.</p>

    <ul class="mgr-detail-list mb-4">
        <li class="mgr-detail-item"><span>Employee Number</span><strong>@Model.EmployeeNumber</strong></li>
        <li class="mgr-detail-item"><span>SA ID Number</span><strong>@Model.SouthAfricanIdNumber</strong></li>
        <li class="mgr-detail-item"><span>Email</span><strong>@Model.EmailAddress</strong></li>
        <li class="mgr-detail-item"><span>Contact</span><strong>@Model.ContactNumber</strong></li>
    </ul>

    <div class="mb-4">
        <div class="fw-semibold text-dark mb-2" style="font-size: 14px;">Assigned Test Types</div>
        <div>
            @if (Model.AssociatedTests.Any())
            {
                foreach (var testName in Model.AssociatedTests)
                {
                    <span class="mgr-chip">@testName</span>
                }
            }
            else
            {
                <span class="text-muted small">No tests currently assigned.</span>
            }
        </div>
    </div>

    <div class="mgr-actions">
        <a asp-action="LabTechnicians" class="btn btn-outline-secondary">Back to List</a>
        <a asp-action="EditLabTechnician" asp-route-id="@Model.Id" class="btn mgr-btn-primary">Edit Technician</a>
    </div>
</div>