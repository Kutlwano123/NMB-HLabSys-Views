@using NMB_HLabSys_VIEWS_.Models
@model LabTechnicianUser
@{
    ViewData["Title"] = "Edit Lab Technician";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Edit Lab Technician</h5>
            </div>
            <div class="card-body">
                <form asp-controller="LabManager" asp-action="EditLabTechnician" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TechnicianId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input name="Name" class="form-control" value="@Model.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Surname</label>
                        <input name="Surname" class="form-control" value="@Model.Surname" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">South African ID Number</label>
                        <input name="SouthAfricanIdNumber" class="form-control" value="@Model.SouthAfricanIdNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Employee Number</label>
                        <input name="EmployeeNumber" class="form-control" value="@Model.EmployeeNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input name="EmailAddress" type="email" class="form-control" value="@Model.EmailAddress" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Number</label>
                        <input name="ContactNumber" class="form-control" value="@Model.ContactNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assigned Test Types</label>
                        <div class="border rounded p-3">
                            @foreach (var testType in ViewBag.TestTypes as List<TestType>)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="AssignedTestTypeIds" value="@testType.Id" id="testType_@testType.Id" checked="@(Model.AssignedTestTypeIds.Contains(testType.Id))" />
                                    <label class="form-check-label" for="testType_@testType.Id">@testType.TestName</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="LabManager" asp-action="LabTechnicians" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

