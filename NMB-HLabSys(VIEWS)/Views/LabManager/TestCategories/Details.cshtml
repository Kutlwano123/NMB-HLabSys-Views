@using NMB_HLabSys_VIEWS_.Models
@model TestCategory
@{
    ViewData["Title"] = "Category Details";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Model.CategoryName</h5>
                <span class="badge bg-light text-dark">
                    @Model.TestTypeIds.Count test type(s)
                </span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Category Name</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>
                </dl>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a asp-controller="LabManager" asp-action="TestCategories" class="btn btn-secondary">Back to List</a>
            <a asp-controller="LabManager" asp-action="EditTestCategory" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        </div>
    </div>
</div>
