@using NMB_HLabSys_VIEWS_.Models
@model TestCategory
@{
    ViewData["Title"] = "Category Details";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}
<style>
    /* Add this if not already in your _ManagersLayout.cshtml */
    .mgr-detail-card {
        background: #fff;
        border: 1px solid var(--mgr-border, #ddd9d2);
        border-radius: 12px;
        padding: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .mgr-detail-title {
        font-family: 'DM Serif Display', serif;
        font-size: 22px;
        color: var(--mgr-text-dark, #1e2420);
        margin-bottom: 6px;
    }

    .mgr-detail-subtitle {
        font-size: 13px;
        color: var(--mgr-text-mid, #4a5248);
        margin-bottom: 20px;
    }

    .mgr-detail-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
        display: grid;
        gap: 10px;
    }

    .mgr-detail-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 12px;
        background: var(--mgr-bg, #f4f2ef);
        border-radius: 8px;
        font-size: 13px;
        color: var(--mgr-text-mid, #4a5248);
    }

    .mgr-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
</style>

<div class="mgr-detail-card">
    <h5 class="mgr-detail-title">@Model.CategoryName</h5>
    <p class="mgr-detail-subtitle">Review category description and linked test types.</p>

    <ul class="mgr-detail-list">
        <li class="mgr-detail-item"><span>Category Name</span><strong>@Model.CategoryName</strong></li>
        <li class="mgr-detail-item"><span>Description</span><strong>@Model.Description</strong></li>
        <li class="mgr-detail-item"><span>Linked Test Types</span><strong>@Model.TestTypeIds.Count test(s)</strong></li>
    </ul>

    <div class="mgr-actions">
        <a asp-action="TestCategories" class="btn btn-outline-secondary">Back</a>
        <a asp-action="EditTestCategory" asp-route-id="@Model.Id" class="btn mgr-btn-primary">Edit</a>
    </div>
</div>