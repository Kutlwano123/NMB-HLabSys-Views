@using NMB_HLabSys_VIEWS_.Models
@model Consumable
@{
    ViewData["Title"] = "Edit Consumable";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Edit Consumables</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ConsumableId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Consumable Name</label>
                        <input name="ConsumableName" class="form-control" value="@Model.ConsumableName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier</label>
                        <select name="SupplierId" class="form-select">
                            @foreach (var supplier in ViewBag.Suppliers as List<Supplier>)
                            {
                                <option value="@supplier.Id" selected="@(supplier.Id == Model.SupplierId)">@supplier.SupplierName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reorder Level</label>
                        <input name="ReorderLevel" class="form-control" type="number" min="0" value="@Model.ReorderLevel" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity on Hand</label>
                        <input name="QuantityOnHand" class="form-control" type="number" min="0" value="@Model.QuantityOnHand" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="LabManager" asp-action="Consumables" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
