@{
    ViewData["Title"] = "Lab Manager Dashboard";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}

<style>
    :root {
        --mgr-bg: #f4f2ef;
        --mgr-surface: #faf9f7;
        --mgr-border: #ddd9d2;
        --mgr-accent: #7a3030;
        --mgr-accent-2: #9a4040;
        --mgr-accent-pale: #f0e8e8;
        --mgr-text-dark: #1e2420;
        --mgr-text-mid: #4a5248;
        --mgr-text-light: #7a857a;
    }

    .lm-dashboard {
        padding: 24px 40px 40px;
        display: grid;
        gap: 20px;
    }

    .lm-hero {
        background: linear-gradient(135deg, #fff7f7 0%, #ffffff 100%);
        border: 1px solid var(--mgr-border);
        border-radius: 20px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    .lm-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--mgr-accent-pale);
        color: var(--mgr-accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .lm-title {
        font-family: 'DM Serif Display', serif;
        font-size: 30px;
        color: var(--mgr-text-dark);
        margin-bottom: 8px;
    }

    .lm-subtitle {
        font-size: 15px;
        color: var(--mgr-text-mid);
        max-width: 720px;
        margin-bottom: 0;
    }

    .lm-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }

    .lm-pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 999px;
        background: var(--mgr-accent);
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: background 0.18s ease;
    }

    .lm-pill-btn.secondary {
        background: #fff;
        color: var(--mgr-accent);
        border: 1px solid var(--mgr-border);
    }

    .lm-pill-btn:hover {
        background: var(--mgr-accent-2);
        color: #fff;
    }

    .lm-pill-btn.secondary:hover {
        background: var(--mgr-accent-pale);
        color: var(--mgr-accent);
    }

    .lm-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }

    .lm-stat {
        background: var(--mgr-surface);
        border: 1px solid var(--mgr-border);
        border-radius: 16px;
        padding: 18px 20px;
        min-height: 118px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .lm-stat-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--mgr-text-light);
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .lm-stat-value {
        font-family: 'DM Serif Display', serif;
        font-size: 28px;
        color: var(--mgr-text-dark);
    }

    .lm-section-heading {
        margin-top: 4px;
    }

    .lm-section-heading h2 {
        font-size: 20px;
        color: var(--mgr-text-dark);
        margin-bottom: 4px;
    }

    .lm-section-heading p {
        color: var(--mgr-text-mid);
        margin-bottom: 0;
    }

    .lm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
    }

    .lm-link-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #fff;
        border: 1px solid var(--mgr-border);
        border-radius: 16px;
        padding: 18px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        min-height: 132px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
    }

    .lm-link-card:hover {
        transform: translateY(-3px);
        border-color: var(--mgr-accent);
        box-shadow: 0 12px 24px rgba(122, 48, 48, 0.12);
    }

    .lm-link-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--mgr-accent-pale);
        color: var(--mgr-accent);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .lm-card-copy {
        flex: 1;
    }

    .lm-card-copy h3 {
        font-size: 16px;
        color: var(--mgr-text-dark);
        margin-bottom: 6px;
    }

    .lm-card-copy p {
        font-size: 13px;
        color: var(--mgr-text-mid);
        margin-bottom: 0;
    }

    .lm-card-arrow {
        color: var(--mgr-text-light);
        font-size: 18px;
        margin-left: auto;
        transition: transform 0.18s ease;
    }

    .lm-link-card:hover .lm-card-arrow {
        transform: translateX(3px);
        color: var(--mgr-accent);
    }

    @@media (max-width: 768px) {
        .lm-dashboard {
            padding: 20px;
        }

        .lm-hero {
            flex-direction: column;
        }

        .lm-hero-actions {
            justify-content: flex-start;
        }
    }
</style>

<section class="lm-dashboard">
    <div class="lm-hero">
        <div>
            <div class="lm-badge"><i class="bi bi-speedometer2"></i> Live operations overview</div>
            <h1 class="lm-title">Lab Manager Control Center</h1>
            <p class="lm-subtitle">Coordinate tests, staff, and inventory from one streamlined workspace. Select a module below to jump directly into the relevant page.</p>
        </div>
        <div class="lm-hero-actions">
            <a asp-action="Orders" class="lm-pill-btn"><i class="bi bi-cart4"></i> Open orders</a>
            <a asp-action="Profile" class="lm-pill-btn secondary"><i class="bi bi-person-circle"></i> View profile</a>
        </div>
    </div>

    <div class="lm-stats">
        <div class="lm-stat">
            <div class="lm-stat-label"><i class="bi bi-eyedropper"></i> Active test requests</div>
            <div class="lm-stat-value">48</div>
        </div>
        <div class="lm-stat">
            <div class="lm-stat-label"><i class="bi bi-check2-circle"></i> Results awaiting review</div>
            <div class="lm-stat-value">12</div>
        </div>
        <div class="lm-stat">
            <div class="lm-stat-label"><i class="bi bi-exclamation-triangle"></i> Urgent cases</div>
            <div class="lm-stat-value">5</div>
        </div>
        <div class="lm-stat">
            <div class="lm-stat-label"><i class="bi bi-box-seam"></i> Inventory alerts</div>
            <div class="lm-stat-value">3</div>
        </div>
    </div>

    <div class="lm-section-heading">
        <h2>Operations modules</h2>
        <p>Each module opens its dedicated page so you can work with confidence and keep daily operations moving.</p>
    </div>

    <div class="lm-grid">
        <a asp-action="TestCategories" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-diagram-3"></i></div>
            <div class="lm-card-copy">
                <h3>Test Categories</h3>
                <p>Review and manage the categories that structure test workflows and reporting.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="TestTypes" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-flask"></i></div>
            <div class="lm-card-copy">
                <h3>Test Types</h3>
                <p>Maintain available tests and keep the catalog aligned with current lab requirements.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="SampleTypes" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-droplet"></i></div>
            <div class="lm-card-copy">
                <h3>Sample Types</h3>
                <p>Manage specimen classifications and ensure every sample is routed correctly.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="Consumables" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-box2-heart"></i></div>
            <div class="lm-card-copy">
                <h3>Consumables</h3>
                <p>Track inventory levels and keep the consumables list up to date for daily use.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="Suppliers" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-truck"></i></div>
            <div class="lm-card-copy">
                <h3>Suppliers</h3>
                <p>View procurement partners and keep vendor information accessible for operations.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="Orders" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-cart4"></i></div>
            <div class="lm-card-copy">
                <h3>Orders</h3>
                <p>Monitor purchase requests, stock movement, and procurement follow-ups.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="Doctors" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-person-hearts"></i></div>
            <div class="lm-card-copy">
                <h3>Doctors</h3>
                <p>Access doctor records and keep clinical contact details aligned with operations.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>

        <a asp-action="LabTechnicians" class="lm-link-card">
            <div class="lm-link-icon"><i class="bi bi-people"></i></div>
            <div class="lm-card-copy">
                <h3>Lab Technicians</h3>
                <p>Review technician assignments and support staffing visibility across the lab.</p>
            </div>
            <span class="lm-card-arrow"><i class="bi bi-chevron-right"></i></span>
        </a>
    </div>
</section>
