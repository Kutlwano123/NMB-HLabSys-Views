@using NMB_HLabSys_VIEWS_.Models
@model DoctorUser
@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Edit Doctor</h5>
            </div>
            <div class="card-body">
                <form asp-controller="LabManager" asp-action="EditDoctor" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DoctorId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input name="Name" class="form-control" value="@Model.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Surname</label>
                        <input name="Surname" class="form-control" value="@Model.Surname" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">HPCSA Number</label>
                        <input name="HpcsaNumber" class="form-control" value="@Model.HpcsaNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input name="EmailAddress" type="email" class="form-control" value="@Model.EmailAddress" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Number</label>
                        <input name="ContactNumber" class="form-control" value="@Model.ContactNumber" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="LabManager" asp-action="Doctors" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
