@using NMB_HLabSys_VIEWS_.Models
@{
    ViewData["Title"] = "Create Doctor";
    Layout = "~/Views/Shared/_ManagersLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Add New Doctor</h5>
            </div>
            <div class="card-body">
                <form asp-controller="LabManager" asp-action="CreateDoctor" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control" placeholder="Enter doctor name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Surname</label>
                        <input name="Surname" class="form-control" placeholder="Enter doctor surname" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">HPCSA Number</label>
                        <input name="HpcsaNumber" class="form-control" placeholder="Enter HPCSA number" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="EmailAddress" type="email" class="form-control" placeholder="Enter email address" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact Number</label>
                        <input name="ContactNumber" class="form-control" placeholder="Enter contact number" />
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning">Add Doctor</button>
                        <a asp-controller="LabManager" asp-action="Doctors" class="btn btn-outline-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
